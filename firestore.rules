rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function deletionStatus(data) {
      return data.get('deletionStatus', 'none');
    }

    function validUserCreate() {
      return deletionStatus(request.resource.data) == 'none'
        && !request.resource.data.keys().hasAny(['deletionRequestedAt']);
    }

    function deletionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['deletionStatus', 'deletionRequestedAt']);
    }

    function validDeletionRequest() {
      return deletionStatus(resource.data) == 'none'
        && deletionStatus(request.resource.data) == 'pending'
        && request.resource.data.deletionRequestedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deletionStatus', 'deletionRequestedAt']);
    }

    // FIXME(defense): Firestore may keep an old admin claim until the client ID
    // token refreshes (normally within one hour); server routes reject revoked tokens immediately.
    match /admins/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deviceConfigs/{configToken} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /rules/{ruleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deleteRequests/{requestId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId)
        && (deletionFieldsUnchanged() || validDeletionRequest());
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
