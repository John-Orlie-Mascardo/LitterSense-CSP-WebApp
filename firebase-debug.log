[debug] [2026-08-23T15:25:37.964Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/littersense-d52b2/rulesets {"name":"projects/littersense-d52b2/rulesets/eab6891e-5e69-40a7-8581-20e276c5958d","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return signedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return signedIn() && request.auth.token.email != null && (\r\n        request.auth.token.email == \"maclaurenz.cultura@gmail.com\" ||\r\n        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))\r\n      );\r\n    }\r\n\r\n    match /admins/{emailId} {\r\n      allow get: if (signedIn() && request.auth.token.email == emailId) || isAdmin();\r\n      allow list, write: if isAdmin();\r\n    }\r\n\r\n    match /deviceConfigs/{configToken} {\r\n      allow get: if true;\r\n      allow list: if false;\r\n      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;\r\n      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;\r\n    }\r\n\r\n    match /rules/{ruleId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /deleteRequests/{requestId} {\r\n      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;\r\n      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /users/{userId} {\r\n      allow read: if isOwner(userId) || isAdmin();\r\n      allow create, update: if isOwner(userId);\r\n      allow delete: if isOwner(userId) || isAdmin();\r\n\r\n      match /cats/{catId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /catDetails/{catId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /sessions/{sessionId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /healthLogs/{logId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /notifications/{notificationId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /reports/{reportId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /settings/{settingId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /deviceConfig/{configId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /catStats/{catId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n\r\n        match /daily/{date} {\r\n          allow read: if isOwner(userId) || isAdmin();\r\n          allow create, update: if isOwner(userId);\r\n          allow delete: if isOwner(userId) || isAdmin();\r\n        }\r\n      }\r\n\r\n      match /catSessionLog/{catId} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n      }\r\n\r\n      match /dailyCatStats/{date} {\r\n        allow read: if isOwner(userId) || isAdmin();\r\n        allow create, update: if isOwner(userId);\r\n        allow delete: if isOwner(userId) || isAdmin();\r\n\r\n        match /cats/{catId} {\r\n          allow read: if isOwner(userId) || isAdmin();\r\n          allow create, update: if isOwner(userId);\r\n          allow delete: if isOwner(userId) || isAdmin();\r\n        }\r\n      }\r\n    }\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-08-23T15:25:39.106687Z","metadata":{"services":["cloud.firestore"]}}
