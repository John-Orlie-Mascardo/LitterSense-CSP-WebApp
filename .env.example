# Firebase web app configuration (public; embedded at build time).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional analytics identifier.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only: base64-encoded service account JSON for the same Firebase project.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Server-only: required for predictive health explanations.
GEMINI_API_KEY=

# Camera: leave unset until a cloud-reachable camera gateway is available.
# ESP32_BASE_URL=https://camera-gateway.example.com
# ESP32_STREAM_URL=https://camera-gateway.example.com/stream

# LOCAL DEVELOPMENT ONLY: Vercel cannot reach these private LAN endpoints.
# ESP32_SENSOR_URL=http://<rfid-board-ip>/sensors
# ESP32_GAS_ULTRASONIC_URL=http://<gas-board-ip>/sensors
# NEXT_PUBLIC_DEVICE_CONFIG_ORIGIN=http://<pc-lan-ip>:3000

# Remote camera: server-only. Same secret on Vercel and the relay; never NEXT_PUBLIC_.
CAMERA_RELAY_URL=
CAMERA_RELAY_SECRET=
# Stable production origin used when generating camera pairing codes.
CAMERA_APP_ORIGIN=
